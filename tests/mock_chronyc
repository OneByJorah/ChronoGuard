#!/usr/bin/env python3
"""Mock `chronyc` for offline testing — returns realistic canned output.

Point CHRONYC_PATH at this file (or the tests do it for you). Any command
other than clients/tracking/sources/sourcestats/activity fails so the app's
error handling can be exercised.
"""
