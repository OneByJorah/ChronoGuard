SOURCESTATS = """\
210 Number of sources = 2
                             .- Number of sample points in measurement set.
                            /    .- Number of residual runs with same sign.
                           |    /    .- Amount of clock drift between samples.
                           |   |    /  .- Reported last interval from sources.
                           |   |   |   /    .- Reported NTP interval.
