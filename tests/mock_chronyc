"""

ACTIVITY = """\
200 OK
2 sources online
1 sources offline
1 sources are being burst-resynced
1 sources in unknown state
0 sources in error state
"""


def main():
    cmd = " ".join(sys.argv[1:])
    if "clients" in cmd:
        sys.stdout.write(CLIENTS)
    elif "tracking" in cmd:
        sys.stdout.write(TRACKING)
    elif "sourcestats" in cmd:  # must precede "sources" (substring!)
        sys.stdout.write(SOURCESTATS)
    elif "sources" in cmd:
        sys.stdout.write(SOURCES)
    elif "activity" in cmd:
        sys.stdout.write(ACTIVITY)
    else:
        sys.stderr.write("mock chronyc: unknown/%s command: %s\n" % ("mock", cmd))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
