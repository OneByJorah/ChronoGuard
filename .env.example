# ChronoGuard — Chrony NTP monitoring dashboard
# Copy to .env or export in the environment. Every value is optional —
# the app ships with safe defaults, so an empty config "just works".

# Web server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Dashboard auto-refresh (milliseconds)
REFRESH_INTERVAL=3000

# chronyc invocation
CHRONYC_PATH=/usr/bin/chronyc
CHRONYC_TIMEOUT=15

# Remote/container chrony daemon (leave empty to use the local unix socket)
CHRONY_HOST=
CHRONY_PORT=323

# Host events feed (auto-detected when empty)
EVENTS_LOG=/var/log/chrony/chronyd.log
EVENTS_TAIL=100
